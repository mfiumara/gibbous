{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gibbous",
  "mainBinaryName": "gibbous",
  "version": "1.2.0",
  "identifier": "dev.gibbous.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Gibbous, the Hermes-native AI cockpit",
    "longDescription": "A native window around your Gibbous server: signs in to the local server automatically, system notifications, tray icon, global hotkey and launch at login.",
    "publisher": "Gibbous",
    "homepage": "https://gibbousapp.com",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
