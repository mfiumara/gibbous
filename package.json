{
  "name": "gibbous",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter web build",
    "start": "node server/main.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "GIBBOUS_HOME=/tmp/gibbous-test-home node --test \"server/*.test.ts\" \"web/src/**/*.test.ts\"",
    "sync:contract": "cp ~/.hermes/hermes-agent/apps/shared/src/gateway-contract.generated.ts web/src/hermes/contract.ts",
    "postinstall": "find node_modules/.pnpm -path \"*node-pty*/spawn-helper\" -exec chmod +x {} +",
    "e2e": "node e2e/run.ts",
    "monkey": "node e2e/monkey.ts"
  },
  "devDependencies": {
    "playwright-core": "1.64.0",
    "puppeteer-core": "^25.12.0"
  }
}
