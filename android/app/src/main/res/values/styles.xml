<?xml version="1.0" encoding="utf-8"?>
<!-- The app's two button styles: tide-filled primary and a quiet well (ios Server.swift UIButton.gibbous). -->
<resources>
  <style name="Gibbous.Button.Primary" parent="Widget.Material3.Button">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">54dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="backgroundTint">@color/tide</item>
    <item name="android:textColor">@color/bg</item>
    <item name="iconTint">@color/bg</item>
    <item name="iconGravity">textStart</item>
    <item name="iconPadding">8dp</item>
    <item name="cornerRadius">14dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <style name="Gibbous.Button.Secondary" parent="Gibbous.Button.Primary">
    <item name="backgroundTint">@color/well</item>
    <item name="android:textColor">@color/text</item>
    <item name="iconTint">@color/text</item>
    <item name="rippleColor">#22FFFFFF</item>
  </style>
  <style name="Gibbous.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
    <item name="colorPrimary">@color/tide</item>
    <item name="colorSurface">#FF1F2228</item>
    <item name="colorOnSurface">@color/text</item>
    <item name="android:textColorPrimary">@color/text</item>
  </style>
</resources>
